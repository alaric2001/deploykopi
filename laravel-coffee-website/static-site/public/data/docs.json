  "flow": [
    {
      "title": "Pilih Produk & Varian",
      "desc": "Browse katalog kopi, pilih jenis biji (Robusta/Arabica), atur quantity. Produk habis ditandai otomatis."
    },
    {
      "title": "Keranjang Belanja",
      "desc": "Item tersimpan di LocalStorage (static demo) atau tbl_cart (Laravel fullstack)."
    },
    {
      "title": "Checkout & Alamat",
      "desc": "Pilih Delivery/Takeaway, pilih alamat pengiriman, ongkir dihitung otomatis per kecamatan."
    },
    {
      "title": "Pembayaran",
      "desc": "Upload bukti transfer ke QRIS atau rekening bank. Gambar dikompresi otomatis sebelum disimpan."
    },
    {
      "title": "Verifikasi & Pengiriman",
      "desc": "Admin konfirmasi pembayaran, update status pengiriman. Pemilik pantau via dashboard analitik."
    }
  ],
